---
export interface TocSection {
  id: string;
  topic: string;
  lessons: { id: string; number: number; title: string; headings: { slug: string; text: string }[] }[];
}

interface Props {
  sections: TocSection[];
}

const { sections } = Astro.props;
---

<p class="mb-4 text-xs font-semibold tracking-wider text-stone-500 uppercase">Temas</p>
<ol class="space-y-6 text-sm">
  {
    sections.map((section) => (
      <li>
        <a
          href={`#${section.id}`}
          class="font-semibold text-stone-900 hover:text-amber-600 aria-[current=true]:text-amber-600 dark:text-stone-100 dark:hover:text-amber-400 dark:aria-[current=true]:text-amber-400"
        >
          {section.topic}
        </a>
        <ol class="mt-2 space-y-3 border-l border-stone-200 dark:border-stone-800">
          {section.lessons.map((lesson) => (
            <li>
              <a
                href={`#${lesson.id}`}
                class="-ml-px block border-l-2 border-transparent pl-3 leading-snug text-stone-700 hover:border-amber-500 hover:text-amber-700 aria-[current=true]:border-amber-500 aria-[current=true]:font-medium aria-[current=true]:text-amber-700 dark:text-stone-300 dark:hover:text-amber-400 dark:aria-[current=true]:text-amber-400"
              >
                <span class="block text-xs text-stone-400">Clase {lesson.number}</span>
                {lesson.title}
              </a>
              <ul class="mt-1.5 space-y-1 pl-6">
                {lesson.headings.map((heading, index) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="-ml-2 block rounded-md px-2 py-0.5 text-[0.8125rem] leading-snug text-stone-500 hover:text-amber-700 aria-[current=true]:bg-amber-100 aria-[current=true]:font-medium aria-[current=true]:text-amber-800 dark:text-stone-400 dark:hover:text-amber-400 dark:aria-[current=true]:bg-amber-400/15 dark:aria-[current=true]:text-amber-300"
                    >
                      <span class="mr-1.5 text-stone-400 tabular-nums">{index + 1}.</span>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </li>
    ))
  }
</ol>
