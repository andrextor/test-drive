---
import '@fontsource-variable/lexend';
import '../styles/global.css';
import { getCollection, render } from 'astro:content';
import Toc, { type TocSection } from '../components/Toc.astro';

const slugify = (text: string) =>
  text
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const formatDate = new Intl.DateTimeFormat('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// Classes (with a date) go first, in date order; undated complements go last.
const entries = (await getCollection('lessons')).sort(
  (a, b) =>
    (a.data.date?.getTime() ?? Number.POSITIVE_INFINITY) - (b.data.date?.getTime() ?? Number.POSITIVE_INFINITY) ||
    a.id.localeCompare(b.id),
);

const lessons = await Promise.all(
  entries.map(async (entry, index) => {
    const { Content, headings } = await render(entry);
    const label = entry.data.date ? `Clase ${index + 1}` : 'Complemento';
    const id = entry.data.date ? `clase-${index + 1}` : `complemento-${entry.id}`;
    return { entry, Content, label, id, headings };
  }),
);

const topics = new Map<string, typeof lessons>();
for (const lesson of lessons) {
  topics.set(lesson.entry.data.topic, [...(topics.get(lesson.entry.data.topic) ?? []), lesson]);
}
const sections = [...topics].map(([topic, items]) => ({ id: `tema-${slugify(topic)}`, topic, items }));

const toc: TocSection[] = sections.map((section) => ({
  id: section.id,
  topic: section.topic,
  lessons: section.items.map((lesson) => ({
    id: lesson.id,
    label: lesson.label,
    title: lesson.entry.data.title,
    headings: lesson.headings.filter((heading) => heading.depth === 3),
  })),
}));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />
    <title>Clases teóricas - Licencia de conducción</title>
  </head>
  <body class="bg-stone-50 font-sans text-stone-800 antialiased dark:bg-stone-950 dark:text-stone-200">
    <header
      class="sticky top-0 z-20 border-b border-stone-200/80 bg-stone-50/85 backdrop-blur-md dark:border-stone-800/80 dark:bg-stone-950/85"
    >
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:gap-8">
        <a href="#" class="shrink-0">
          <span class="block text-[0.6875rem] font-semibold tracking-widest text-amber-600 uppercase dark:text-amber-400">
            Licencia de conducción
          </span>
          <span class="block text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-50">Clases teóricas</span>
        </a>

        <form role="search" id="search-form" class="relative flex flex-1 items-center">
          <svg
            class="pointer-events-none absolute left-3.5 size-4 text-stone-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            id="search"
            type="search"
            autocomplete="off"
            enterkeyhint="search"
            placeholder="Buscar: art 67, culata, preventivas…"
            aria-label="Buscar en los apuntes"
            class="w-full rounded-xl border border-stone-300 bg-white py-2.5 pr-32 pl-10 text-base shadow-sm outline-none placeholder:text-stone-400 focus:border-amber-500 focus:ring-4 focus:ring-amber-500/15 dark:border-stone-700 dark:bg-stone-900"
          />
          <div class="absolute right-1.5 flex items-center gap-0.5">
            <span id="search-count" class="mr-1 text-xs text-stone-500 tabular-nums" aria-live="polite"></span>
            <button
              type="button"
              id="search-prev"
              aria-label="Resultado anterior"
              class="grid size-8 place-items-center rounded-lg text-stone-500 hover:bg-stone-100 disabled:opacity-30 dark:hover:bg-stone-800"
              disabled
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m6 15 6-6 6 6"></path>
              </svg>
            </button>
            <button
              type="submit"
              id="search-next"
              aria-label="Resultado siguiente"
              class="grid size-8 place-items-center rounded-lg text-stone-500 hover:bg-stone-100 disabled:opacity-30 dark:hover:bg-stone-800"
              disabled
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
          </div>
        </form>

        <a
          href="/preguntas"
          class="shrink-0 rounded-xl bg-amber-500 px-3.5 py-2.5 text-center text-sm font-semibold text-stone-950 shadow-sm hover:bg-amber-400"
        >
          Preguntas de examen
        </a>

        <button
          type="button"
          onclick="print()"
          class="hidden shrink-0 items-center gap-2 rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-medium text-stone-600 shadow-sm hover:bg-stone-100 sm:flex dark:border-stone-700 dark:bg-stone-900 dark:text-stone-300 dark:hover:bg-stone-800"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 9V3h12v6M6 18H4v-7h16v7h-2M8 14h8v7H8z"></path>
          </svg>
          Imprimir / PDF
        </button>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-4 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12">
      <main id="notes" class="min-w-0 pt-8 pb-[70vh]">
        <p class="mb-8 flex flex-wrap gap-x-4 gap-y-2 text-xs text-stone-500">
          <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-sky-400"></span>Definición</span>
          <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-emerald-400"></span>Ojo / ejemplo</span>
          <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-amber-500"></span>Pregunta de examen</span>
          <span><strong class="font-semibold text-stone-700 dark:text-stone-300">(?)</strong> dato por confirmar con el profesor</span>
        </p>
        {
          sections.map((section) => (
            <section id={section.id} class="mb-14 scroll-mt-36 sm:scroll-mt-24">
              <h2 class="mb-5 flex items-center gap-3 text-2xl font-semibold tracking-tight text-stone-900 dark:text-stone-50">
                <span class="h-6 w-1.5 rounded-full bg-amber-500" aria-hidden="true" />
                {section.topic}
              </h2>
              {section.items.map(({ entry, Content, label, id }) => (
                <article
                  id={id}
                  class="mb-6 scroll-mt-36 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:scroll-mt-24 sm:p-8 dark:border-stone-800 dark:bg-stone-900"
                >
                  <header class="mb-6 border-b border-stone-200 pb-5 dark:border-stone-800">
                    <div class="mb-2 flex flex-wrap items-center gap-2 text-sm">
                      <span
                        class:list={[
                          'rounded-full px-2.5 py-0.5 text-xs font-semibold',
                          entry.data.date
                            ? 'bg-amber-100 text-amber-800 dark:bg-amber-400/15 dark:text-amber-300'
                            : 'bg-stone-200 text-stone-700 dark:bg-stone-700 dark:text-stone-200',
                        ]}
                      >
                        {label}
                      </span>
                      {entry.data.date ? (
                        <time datetime={entry.data.date.toISOString().slice(0, 10)} class="text-stone-500">
                          {formatDate.format(entry.data.date)}
                        </time>
                      ) : (
                        <span class="text-stone-500">No visto en clase: verificar con el profesor</span>
                      )}
                    </div>
                    <h3 class="text-xl font-semibold tracking-tight text-stone-900 sm:text-2xl dark:text-stone-50">
                      {entry.data.title}
                    </h3>
                  </header>
                  <div class="notes prose max-w-none prose-stone dark:prose-invert prose-headings:scroll-mt-36 prose-headings:tracking-tight prose-h3:mt-10 prose-h3:text-lg prose-h3:text-amber-700 first:prose-h3:mt-0 prose-table:text-sm sm:prose-headings:scroll-mt-24 dark:prose-h3:text-amber-400">
                    <Content />
                  </div>
                </article>
              ))}
            </section>
          ))
        }
      </main>

      <aside class="hidden lg:block">
        <nav aria-label="Temas" class="sticky top-24 max-h-[calc(100dvh-7rem)] overflow-y-auto pt-8 pb-8">
          <Toc sections={toc} />
        </nav>
      </aside>
    </div>

    <button
      type="button"
      popovertarget="toc-mobile"
      class="fixed right-4 bottom-4 z-30 flex items-center gap-2 rounded-full bg-stone-900 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-stone-900/20 lg:hidden dark:bg-amber-500 dark:text-stone-950"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h10"></path>
      </svg>
      Temas
    </button>

    <nav
      id="toc-mobile"
      popover
      aria-label="Temas"
      class="fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-none w-80 max-w-[85vw] overflow-y-auto border-l border-stone-200 bg-white p-6 shadow-2xl backdrop:bg-stone-950/40 lg:hidden dark:border-stone-800 dark:bg-stone-900 dark:text-stone-200"
    >
      <Toc sections={toc} />
    </nav>

    <script>
      const tocMobile = document.querySelector<HTMLElement>('#toc-mobile');
      for (const link of tocMobile?.querySelectorAll('a') ?? []) {
        link.addEventListener('click', () => tocMobile?.hidePopover());
      }

      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]')];
      const sectionEls = [...document.querySelectorAll<HTMLElement>('main section, main article, main .notes h3')];

      // The current position is the last section/class/sub-theme whose top has scrolled past the sticky header.
      const markCurrent = () => {
        const offset = (document.querySelector('body > header')?.clientHeight ?? 0) + 64;
        const passed = sectionEls.filter((el) => el.getBoundingClientRect().top <= offset);
        const lesson = passed.findLast((el) => el.tagName === 'ARTICLE');
        const current = new Set(
          [
            passed.findLast((el) => el.tagName === 'SECTION'),
            lesson,
            passed.findLast((el) => el.tagName === 'H3' && el.closest('article') === lesson),
          ].map((el) => el?.id),
        );
        for (const link of tocLinks) {
          const isCurrent = current.has(decodeURIComponent(link.hash.slice(1)));
          if (isCurrent && link.getAttribute('aria-current') !== 'true' && link.closest('aside')) {
            link.scrollIntoView({ block: 'nearest' });
          }
          link.setAttribute('aria-current', String(isCurrent));
        }
      };
      let scheduled = false;
      addEventListener(
        'scroll',
        () => {
          if (scheduled) return;
          scheduled = true;
          requestAnimationFrame(() => {
            scheduled = false;
            markCurrent();
          });
        },
        { passive: true },
      );
      markCurrent();

      const notes = document.querySelector<HTMLElement>('#notes');
      const form = document.querySelector<HTMLFormElement>('#search-form');
      const input = document.querySelector<HTMLInputElement>('#search');
      const count = document.querySelector<HTMLElement>('#search-count');
      const prev = document.querySelector<HTMLButtonElement>('#search-prev');
      const next = document.querySelector<HTMLButtonElement>('#search-next');

      // Folding char by char keeps folded indexes aligned with the original text node offsets.
      const fold = (text: string) =>
        text
          .split('')
          .map((char) => char.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase()[0] ?? char)
          .join('');

      let matches: Range[] = [];
      let current = 0;

      const focusMatch = (index: number) => {
        if (!matches.length || !count) return;
        current = (index + matches.length) % matches.length;
        const range = matches[current];
        CSS.highlights.set('search-current', new Highlight(range));
        count.textContent = `${current + 1}/${matches.length}`;
        range.startContainer.parentElement?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      };

      const search = () => {
        if (!notes || !input || !count || !prev || !next) return;
        CSS.highlights.clear();
        matches = [];
        const query = fold(input.value.trim());
        const words = query.match(/[\p{L}\p{N}]+/gu) ?? [];
        if (query.length >= 2 && words.length) {
          // Separators in the query match any punctuation/space, so "art 67" finds "art. 67".
          const pattern = new RegExp(words.join('[^\\p{L}\\p{N}]+'), 'gu');
          const walker = document.createTreeWalker(notes, NodeFilter.SHOW_TEXT);
          for (let node = walker.nextNode(); node; node = walker.nextNode()) {
            for (const match of fold(node.textContent ?? '').matchAll(pattern)) {
              const range = new Range();
              range.setStart(node, match.index);
              range.setEnd(node, match.index + match[0].length);
              matches.push(range);
            }
          }
        }
        CSS.highlights.set('search', new Highlight(...matches));
        count.textContent = query.length >= 2 ? (matches.length ? '' : '0') : '';
        prev.disabled = next.disabled = !matches.length;
        focusMatch(0);
      };

      input?.addEventListener('input', search);
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        focusMatch(current + 1);
      });
      prev?.addEventListener('click', () => focusMatch(current - 1));
      input?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && event.shiftKey) {
          event.preventDefault();
          focusMatch(current - 1);
        }
      });
    </script>
  </body>
</html>
