---
import '@fontsource-variable/lexend';
import '../styles/global.css';

type Question = { question: string; answer: string; source: string };

// Keep in sync with the `>` blockquotes in the lessons (see CLAUDE.md).
const fixed: Question[] = [
  {
    question: '¿A cuánto equivalen las multas tipo C (C2)?',
    answer: '15 SMDLV, valor $604.147. (Art. 131, Ley 769 de 2002)',
    source: 'Clase 24 nov.',
  },
  {
    question: 'El Código Nacional de Tránsito es la…',
    answer: 'Ley 769 de 2002 (art. 1: ámbito de aplicación).',
    source: 'Clase 24 nov.',
  },
  {
    question: '¿Qué NO es obligatorio (es opcional) en el kit de carretera?',
    answer: 'Chaleco o prenda reflectiva; no está en la lista del art. 30.',
    source: 'Clase 24 nov.',
  },
];

const possible: Question[] = [
  {
    question: '¿Cuándo nacieron las leyes de tránsito?',
    answer:
      '1974, en Viena (Austria). (?) La Convención de Viena es de 1968: confirmar. (Convención de Viena: no es un artículo del CNT)',
    source: 'Adaptación al medio',
  },
  {
    question: '¿Qué artículo del Código Nacional de Tránsito trata las señales luminosas (semáforos)?',
    answer: 'Art. 118 del CNT.',
    source: 'Adaptación al medio',
  },
  {
    question: 'Art. 67: ¿a cuántos metros de la esquina se señaliza un giro con la direccional?',
    answer: '30 m en vías urbanas y 60 m en vías rápidas (art. 67).',
    source: 'Adaptación al medio',
  },
  {
    question: '¿Qué pasa si el conductor se niega a la prueba de alcohol?',
    answer:
      'El agente le hace directamente el comparendo de grado 3 (la sanción más alta). (Art. 152 CNT, modificado por la Ley 1696 de 2013)',
    source: 'Embriaguez y sustancias',
  },
  {
    question: '¿Qué pasa con la multa si el infractor huye?',
    answer: 'Se duplica (art. 130).',
    source: 'Infracciones de tránsito',
  },
];

const groups = [
  { title: 'Fijas: salen seguro', note: 'Las 3 del concurso, con su respuesta.', items: fixed },
  { title: 'Posibles', note: 'Las que el profesor dijo en clase que pueden salir.', items: possible },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Preguntas de examen - Licencia de conducción</title>
  </head>
  <body class="bg-stone-50 font-sans text-stone-800 antialiased dark:bg-stone-950 dark:text-stone-200">
    <main class="mx-auto max-w-3xl px-4 py-8">
      <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <a href="/" class="text-[0.6875rem] font-semibold tracking-widest text-amber-600 uppercase dark:text-amber-400">
            ← Clases teóricas
          </a>
          <h1 class="text-2xl font-semibold tracking-tight text-stone-900 dark:text-stone-50">Preguntas de examen</h1>
        </div>
        <button
          type="button"
          onclick="print()"
          class="rounded-xl border border-stone-300 bg-white px-3.5 py-2 text-sm font-medium text-stone-600 shadow-sm hover:bg-stone-100 print:hidden dark:border-stone-700 dark:bg-stone-900 dark:text-stone-300 dark:hover:bg-stone-800"
        >
          Imprimir / PDF
        </button>
      </header>

      {
        groups.map((group) => (
          <section class="mb-10 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-8 print:border-0 print:p-0 print:shadow-none dark:border-stone-800 dark:bg-stone-900">
            <h2 class="text-xl font-semibold tracking-tight text-amber-700 dark:text-amber-400">{group.title}</h2>
            <p class="mb-5 text-sm text-stone-500">{group.note}</p>
            <ol class="list-decimal space-y-4 pl-6 marker:font-semibold marker:text-amber-600">
              {group.items.map((item) => (
                <li class="break-inside-avoid">
                  <p class="font-semibold text-stone-900 dark:text-stone-50">{item.question}</p>
                  <p>
                    <span class="font-semibold text-amber-700 dark:text-amber-400">R:</span> {item.answer}
                  </p>
                  <p class="text-xs text-stone-500">{item.source}</p>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </main>
  </body>
</html>
